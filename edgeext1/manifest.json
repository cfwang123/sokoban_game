{
  "manifest_version": 3,
  "name": "Sokoban 推箱子",
  "version": "1.0.0",
  "description": "教学演示：Edge 扩展内的推箱子（Chromium MV3，与 Chrome 同源）",
  "action": {
    "default_title": "推箱子",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"]
}
