{
  "name": "sokoban-vscode",
  "displayName": "Sokoban",
  "description": "Teaching demo: play Sokoban inside VS Code (Webview)",
  "version": "1.0.0",
  "publisher": "whj-demo",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": ["Other", "Games"],
  "activationEvents": [
    "onCommand:sokoban.open"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sokoban.open",
        "title": "Sokoban: Open Game"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.74.0",
    "typescript": "^5.0.0"
  }
}
