从 游戏 导入 从行创建, 尝试移动, 撤销, 渲染, 状态行, 应用答案步
导入 sys


定义 载入(序号):
    i = 序号 % 长度(关卡列表)
    L = 关卡列表[i]
    返回 从行创建(L["图"], i, L["名"], L["答案"])


定义 套用答案(状态):
    新 = 载入(状态["序号"])
    对于 字 在 状态["答案"]:
        应用答案步(新, 字)
    返回 新


定义 主程序():
    印出("sokoban_草蟒 — 完整游戏（中文关键字源码）")
    关数 = 长度(关卡列表)
    印出("共 " + str(关数) + " 关 · h 帮助")
    序号 = 0
    如果 长度(sys.argv) > 1:
        尝试:
            序号 = 最大(0, 整数(sys.argv[1]) - 1)
        抓住 ValueError:
            传递
    状态 = 载入(序号)
    当 真:
        印出()
        印出(渲染(状态), end="")
        印出(状态行(状态))
        尝试:
            行 = 输入("> ").strip()
        抓住 (EOFError, KeyboardInterrupt):
            印出("\n再见！")
            跳出
        如果 非 行:
            继续
        部件 = 行.split()
        头 = 部件[0]
        低 = 头.lower()
        如果 低 在 ("h", "?", "help"):
            印出("wasd 移动 | z 撤销 | r 重置 | n/p 上下关 | 数字跳关 | sol! 答案 | q 退出")
            继续
        如果 低 在 ("q", "quit"):
            印出("再见！")
            跳出
        如果 低 在 ("n", "]"):
            状态 = 载入(状态["序号"] + 1)
            继续
        如果 低 在 ("p", "["):
            状态 = 载入(状态["序号"] - 1)
            继续
        如果 头.isdigit():
            n = 整数(头)
            如果 1 <= n <= 长度(关卡列表):
                状态 = 载入(n - 1)
            否则:
                印出("关卡 1.." + str(长度(关卡列表)))
            继续
        如果 低 == "r":
            状态 = 载入(状态["序号"])
            继续
        如果 低 == "z":
            如果 非 撤销(状态):
                印出("无法撤销。")
            继续
        如果 低 在 ("sol!", "sol"):
            状态 = 套用答案(状态)
            如果 状态["已过关"]:
                印出("Level clear!")
            继续
        如果 全部(c 在 "wasdudlrWASDUDLR \t" 对于 c 在 行):
            对于 字 在 行.replace(" ", ""):
                c = 字.lower()
                如果 c == "w" 或 c == "u":
                    尝试移动(状态, 0, -1)
                否则如果 c == "s":
                    尝试移动(状态, 0, 1)
                否则如果 c == "a" 或 c == "l":
                    尝试移动(状态, -1, 0)
                否则如果 c == "d" 或 c == "r":
                    尝试移动(状态, 1, 0)
        否则:
            印出("未知命令。h 帮助")
            继续
        如果 状态["已过关"]:
            印出("Level clear!")
            如果 状态["序号"] + 1 < 长度(关卡列表):
                印出("按 n 下一关")


如果 __name__ == "__main__":
    主程序()
