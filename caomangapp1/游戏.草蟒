# 游戏.草蟒 — 推箱子核心（草蟒 / 中文关键字 Python）
# 由 main.py 关键字翻译后执行；本文件即目标语言源码。

从 collections 导入 deque


定义 键(x, y):
    返回 f"{x},{y}"


定义 从行创建(行列表, 序号=0, 名="", 答案=""):
    墙, 目标, 箱子 = set(), set(), set()
    px = py = mx = my = 0
    对于 y, 行 在 枚举(行列表):
        my = y
        对于 x, 字 在 枚举(行):
            mx = 最大(mx, x)
            k = 键(x, y)
            如果 字 == "#":
                墙.add(k)
            否则如果 字 == ".":
                目标.add(k)
            否则如果 字 == "$":
                箱子.add(k)
            否则如果 字 == "*":
                箱子.add(k)
                目标.add(k)
            否则如果 字 == "@":
                px, py = x, y
            否则如果 字 == "+":
                px, py = x, y
                目标.add(k)
    返回 {
        "墙": 墙, "目标": 目标, "箱子": 箱子,
        "px": px, "py": py, "步数": 0, "推次": 0, "已过关": 假,
        "宽": mx + 1, "高": my + 1, "序号": 序号, "名": 名, "答案": 答案,
        "历史": [],
    }


定义 检查过关(状态):
    状态["已过关"] = 全部(b 在 状态["目标"] 对于 b 在 状态["箱子"])


定义 尝试移动(状态, dx, dy):
    如果 状态["已过关"]:
        返回 假
    nx, ny = 状态["px"] + dx, 状态["py"] + dy
    nk = 键(nx, ny)
    如果 nk 在 状态["墙"]:
        返回 假
    如果 nk 在 状态["箱子"]:
        bx, by = nx + dx, ny + dy
        bk = 键(bx, by)
        如果 bk 在 状态["墙"] 或 bk 在 状态["箱子"]:
            返回 假
        状态["历史"].append((状态["px"], 状态["py"], nk, bk, 真))
        状态["箱子"].discard(nk)
        状态["箱子"].add(bk)
        状态["px"], 状态["py"] = nx, ny
        状态["步数"] += 1
        状态["推次"] += 1
        检查过关(状态)
        返回 真
    状态["历史"].append((状态["px"], 状态["py"], 无, 无, 假))
    状态["px"], 状态["py"] = nx, ny
    状态["步数"] += 1
    返回 真


定义 撤销(状态):
    如果 非 状态["历史"]:
        返回 假
    hx, hy, bf, bt, 推 = 状态["历史"].pop()
    状态["px"], 状态["py"] = hx, hy
    如果 推:
        状态["箱子"].discard(bt)
        状态["箱子"].add(bf)
        如果 状态["推次"] > 0:
            状态["推次"] -= 1
    如果 状态["步数"] > 0:
        状态["步数"] -= 1
    状态["已过关"] = 假
    返回 真


定义 渲染(状态):
    行们 = []
    对于 y 在 范围(状态["高"]):
        一行 = []
        对于 x 在 范围(状态["宽"]):
            k = 键(x, y)
            如果 状态["px"] == x 且 状态["py"] == y:
                一行.append("+" 如果 k 在 状态["目标"] 否则 "@")
            否则如果 k 在 状态["箱子"]:
                一行.append("*" 如果 k 在 状态["目标"] 否则 "$")
            否则如果 k 在 状态["墙"]:
                一行.append("#")
            否则如果 k 在 状态["目标"]:
                一行.append(".")
            否则:
                一行.append(" ")
        行们.append("".join(一行))
    返回 "\n".join(行们) + "\n"


定义 状态行(状态):
    旗 = "  WIN!" 如果 状态["已过关"] 否则 ""
    返回 f"[{状态['序号']+1}] {状态['名']}  moves={状态['步数']} pushes={状态['推次']}{旗}"


定义 应用答案步(状态, 字):
    表 = {"u": (0, -1), "U": (0, -1), "d": (0, 1), "D": (0, 1),
          "l": (-1, 0), "L": (-1, 0), "r": (1, 0), "R": (1, 0)}
    如果 字 不在 表:
        返回 假
    dx, dy = 表[字]
    返回 尝试移动(状态, dx, dy)
