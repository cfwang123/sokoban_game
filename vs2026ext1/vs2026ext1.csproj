<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Visual Studio 扩展教学工程（面向 VS 2022/2026 扩展模型）。
    真机打包需安装 Visual Studio SDK / VSSDK 工作负载，并可能改用 VSIX SDK 模板。
    本仓库以可读 C# 演示 Tool Window + 游戏逻辑，不强制产出 .vsix。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Sokoban.VSExt</RootNamespace>
    <AssemblyName>Sokoban.VSExt</AssemblyName>
    <Description>Sokoban teaching extension for Visual Studio</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- 真实 VSIX 工程会引用 Microsoft.VisualStudio.SDK；此处避免强制还原失败 -->
    <!-- <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.0.32112.339" /> -->
  </ItemGroup>
</Project>
