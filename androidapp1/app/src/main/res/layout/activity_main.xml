<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <!-- 紧凑工具栏：全部图标，无横向滚动 -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:paddingTop="6dp"
        android:paddingBottom="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/prevLevelBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_icon_btn"
            android:contentDescription="@string/prev_level"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_prev" />

        <Spinner
            android:id="@+id/levelSpinner"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_icon_btn"
            android:popupBackground="@color/bg_panel"
            android:spinnerMode="dropdown" />

        <TextView
            android:id="@+id/moveCountText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="2dp"
            android:minWidth="28dp"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="0" />

        <ImageButton
            android:id="@+id/undoBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/bg_icon_btn"
            android:contentDescription="@string/undo"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_undo" />

        <ImageButton
            android:id="@+id/resetBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="3dp"
            android:background="@drawable/bg_icon_btn"
            android:contentDescription="@string/reset"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_reset" />

        <ImageButton
            android:id="@+id/viewAnswerBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="3dp"
            android:background="@drawable/bg_icon_btn_accent"
            android:contentDescription="@string/view_answer"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_answer" />

        <ImageButton
            android:id="@+id/helpBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="3dp"
            android:background="@drawable/bg_icon_btn"
            android:contentDescription="@string/help"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_help" />

        <ImageButton
            android:id="@+id/nextLevelBtnToolbar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="3dp"
            android:background="@drawable/bg_icon_btn"
            android:contentDescription="@string/next_level"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_next" />
    </LinearLayout>

    <!-- 状态一行，极矮 -->
    <TextView
        android:id="@+id/aiStatusText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingHorizontal="8dp"
        android:paddingBottom="2dp"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header"
        tools:text="本关有答案" />

    <!-- 棋盘 -->
    <FrameLayout
        android:id="@+id/boardContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="4dp"
        android:layout_marginTop="2dp"
        android:background="@color/bg_board"
        app:layout_constraintBottom_toTopOf="@+id/controls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/aiStatusText">

        <com.whj.sokoban.ui.GameBoardView
            android:id="@+id/gameBoard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />
    </FrameLayout>

    <!-- 底部虚拟方向键（紧凑） -->
    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageButton
            android:id="@+id/btnUp"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_dpad_icon"
            android:contentDescription="@string/dir_up"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_up" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnLeft"
                android:layout_width="48dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_dpad_icon"
                android:contentDescription="@string/dir_left"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_arrow_left" />

            <ImageButton
                android:id="@+id/btnDown"
                android:layout_width="48dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/bg_dpad_icon"
                android:contentDescription="@string/dir_down"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_arrow_down" />

            <ImageButton
                android:id="@+id/btnRight"
                android:layout_width="48dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_dpad_icon"
                android:contentDescription="@string/dir_right"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_arrow_right" />
        </LinearLayout>
    </LinearLayout>

    <!-- 通关遮罩 -->
    <FrameLayout
        android:id="@+id/winOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/overlay"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_dialog"
            android:gravity="center"
            android:minWidth="240dp"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            android:paddingVertical="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/win_title"
                android:textColor="@color/accent"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/winMovesText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                tools:text="共用 12 步完成！" />

            <ImageButton
                android:id="@+id/nextLevelBtn"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_icon_btn_accent"
                android:contentDescription="@string/next_level"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_next" />
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
