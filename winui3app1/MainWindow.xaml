<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SokobanWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Sokoban WinUI 3"
    KeyDown="Window_KeyDown">

  <Grid Background="#1A1A2E" Padding="24">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
      <TextBlock Text="Sokoban · WinUI 3"
                 Foreground="White"
                 FontSize="22"
                 HorizontalAlignment="Center" />
      <TextBlock Text="WASD / 方向键 · Z 撤销 · R 重置"
                 Foreground="#AAAAAA"
                 FontSize="12"
                 HorizontalAlignment="Center" />
      <TextBlock x:Name="BoardText"
                 FontFamily="Consolas"
                 FontSize="22"
                 Foreground="#ECF0F1"
                 HorizontalAlignment="Center" />
      <TextBlock x:Name="StatusText"
                 Foreground="White"
                 HorizontalAlignment="Center" />
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
        <Button Content="W" Click="OnUp" Width="48" />
        <Button Content="A" Click="OnLeft" Width="48" />
        <Button Content="S" Click="OnDown" Width="48" />
        <Button Content="D" Click="OnRight" Width="48" />
        <Button Content="Z" Click="OnUndo" Width="48" />
        <Button Content="R" Click="OnReset" Width="48" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
