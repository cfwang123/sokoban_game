# --- Build artifacts ---
*.o
*.obj
*.obj.d
*.d
*.exe
*.dll
*.lib
*.so
*.dylib
*.a
*.map
*.elf
*.bin
*.swo
*.swp
*~

# Platform ROMs / packages (regenerated by build)
*.nes
*.gba
*.pbp
EBOOT.PBP

# Generic build output dirs
build/

# --- C application ---
c_app/sokoban.exe
c_app/lastlevel.ini

# Local-only deploy / SSH helpers (may contain machine-specific config)
sokoban_linux/*.py
sokoban_linux/*.local
*.local.bat
*.local.sh
*.local.env

# Optional local toolchains dropped into the tree
fcapp1/tools/cc65/
**/tools/cc65/

# --- CMake ---
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CMakeScratch/
CMakeConfigureLog.yaml
compile_commands.json

# --- IDE & Editor ---
.vscode/
.idea/
.trae/
*.user
*.suo

# --- OS files ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Logs, temp, backups ---
*.log
*.tmp
*.temp
*.bak
*.pid
tmp/
tmp_*
*_err.txt
*_out.txt
*_stdout.txt
*_stderr.txt
*_log.txt

# Accidental shell/redirect junk at repo root (leading ! must be escaped)
\!l.solution).length)

# --- Solver runtime (scripts/cpp_solver) ---
scripts/cpp_solver/batch_failed_ids.txt
scripts/cpp_solver/last_level_out.txt

# --- Local agent / machine-specific ---
AGENTS.md
Agents.md
.env
.env.local
.env.*.local
secrets/
**/secrets/

# --- Node.js (if used) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
