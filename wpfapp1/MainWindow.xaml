<Window x:Class="SokobanWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sokoban WPF" SizeToContent="WidthAndHeight"
        Background="#1A1A2E" KeyDown="Window_KeyDown"
        Focusable="True">
  <DockPanel>
    <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Margin="8"
               Foreground="White" FontSize="12"/>
    <Canvas x:Name="Board" Width="300" Height="300"/>
  </DockPanel>
</Window>
